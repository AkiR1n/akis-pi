{
  "permission": {
    "*": "allow",
    "external_directory_read": {
      "*": "allow"
    },
    "external_directory_write": {
      "*": "ask",
      "~/.pi/*": "allow",
      "~/.config/*": "allow",
      "~/Library/LaunchAgents/*": "allow",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/private/var/folders/*": "allow",
      "~/.cache/*": "allow",
      "~/.local/*": "allow"
    },
    "path_write": {
      "~/.pi/agent/sessions/*": "ask",
      "~/.pi/agent/memory/*": "ask"
    },
    "bash": {
      "*": "allow",
      "rm -r*": "ask",
      "rm -R*": "ask",
      "rm -fr*": "ask",
      "rm -fR*": "ask",
      "rm -r* /tmp/*": "allow",
      "rm -r* /private/tmp/*": "allow",
      "rm -r* /private/var/folders/*": "allow",
      "rm -fr* /tmp/*": "allow",
      "rm -fr* /private/tmp/*": "allow",
      "git push *--force*": "ask",
      "git push * -f*": "ask",
      "git push * +*": "ask",
      "rtk git push *--force*": "ask",
      "rtk git push * -f*": "ask",
      "rtk git push * +*": "ask",
      "rtk git -C * push *--force*": "ask",
      "git -C * push *--force*": "ask",
      "git reset --hard*": "ask",
      "rtk git reset --hard*": "ask",
      "git clean *": "ask",
      "rtk git clean *": "ask",
      "git filter-branch *": "ask",
      "git filter-repo *": "ask",
      "sudo *": "ask",
      "pi install *": "ask",
      "pi remove *": "ask",
      "npm publish *": "ask"
    }
  },
  "commandEffects": {
    "df": {
      "effects": "read"
    },
    "du": {
      "effects": "read"
    },
    "readlink": {
      "effects": "read"
    },
    "rtk": {
      "subcommands": {
        "ls": "read",
        "tree": {
          "effects": "read",
          "unlessOption": [
            "-o",
            "--output"
          ]
        },
        "find": {
          "effects": "read",
          "unlessOption": [
            "-exec",
            "-execdir",
            "-ok",
            "-okdir",
            "-delete",
            "-fprint",
            "-fprint0",
            "-fprintf",
            "-fls"
          ]
        },
        "read": "read",
        "grep": "read",
        "wc": "read",
        "stat": "read",
        "du": "read",
        "json": "read",
        "diff": "read",
        "smart": "read"
      }
    }
  },
  "authorizerChain": [
    "auto-review"
  ]
}
