--- /dev/null
+++ b/src/types/tree-sitter-qmljs.d.ts
@@ -0,0 +1,3 @@
+// npm may omit this optional native grammar entirely. Keep source builds possible without it;
+// the lazy runtime import is guarded and grammar values are handled as unknown.
+declare module "tree-sitter-qmljs";
diff --git a/test/unit/qml-optional.test.ts b/test/unit/qml-optional.test.ts
new file mode 100644
index 0000000..6a44f79
--- /dev/null
+++ b/test/unit/qml-optional.test.ts
@@ -0,0 +1,29 @@
+import { afterEach, expect, it, vi } from "vitest";
+
+vi.mock("tree-sitter-qmljs", () => {
+	throw new Error("simulated missing optional native binding");
+});
+
+afterEach(() => vi.restoreAllMocks());
+
+it("falls back for concurrent and repeated QML loads once while TypeScript AST remains available", async () => {
+	const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+	const { analyzeIndexableContent } = await import("../../src/indexer/chunker.ts");
+	const qml = "Item { property string title: 'Example' }";
+	const results = await Promise.all([
+		analyzeIndexableContent(qml, "ui/One.qml"),
+		analyzeIndexableContent(qml, "ui/Two.qml"),
+	]);
+	results.push(await analyzeIndexableContent(qml, "ui/Three.qml"));
+	for (const result of results) {
+		expect(result.chunks.length).toBeGreaterThan(0);
+		expect(result.chunks.map((chunk) => chunk.content).join(" ")).toContain("Example");
+		expect(JSON.parse(result.chunks[0].metadata_json).language).toBeUndefined();
+	}
+	expect(warn).toHaveBeenCalledTimes(1);
+	expect(warn.mock.calls[0][0]).toContain("Optional QML parser unavailable");
+	expect(warn.mock.calls[0][0]).not.toContain("simulated");
+	const ts = await analyzeIndexableContent("export function retained() { return 1; }", "src/main.ts");
+	expect(ts.symbols.some((symbol) => symbol.name === "retained")).toBe(true);
+	expect(JSON.parse(ts.chunks[0].metadata_json).language).toBe("typescript");
+});
