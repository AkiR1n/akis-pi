@@ -79,6 +79,9 @@ function moduleDefault(moduleValue: unknown): unknown {
 	return moduleField(moduleValue, "default");
 }
 
+// Cache success or failure before yielding so concurrent QML files share one load and notice.
+let qmlGrammar: Promise<unknown> | undefined;
+
 const LANGS: Record<string, LangConfig> = {
 	typescript: {
 		grammar: async () => {
@@ -147,9 +150,19 @@ const LANGS: Record<string, LangConfig> = {
