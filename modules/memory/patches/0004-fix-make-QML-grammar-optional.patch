+					const m = await import("tree-sitter-qmljs");
+					return moduleDefault(m) ?? m;
+				} catch {
+					console.warn(
+						"[pi-knowledge] Optional QML parser unavailable; QML files use text chunks. Other languages are unaffected.",
+					);
+					throw new Error("Optional QML parser unavailable");
+				}
+			})();
