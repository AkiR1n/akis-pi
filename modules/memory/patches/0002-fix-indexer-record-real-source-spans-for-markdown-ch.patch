From cad4de4e21fc11d8857320fa9d2dc9e9a04c9b75 Mon Sep 17 00:00:00 2001
From: AkiyamaRin <akir1n@outlook.com>
Date: Sat, 24 Oct 2026 00:09:21 +0800
Subject: [PATCH 2/3] fix(indexer): record real source spans for markdown
 chunks

chunkMarkdown used the section's last line as the start of every chunk after the
first, so sibling chunks in one section all reported the same line and looked
fully redundant to lineProximity (and to readers). Paragraphs are now grouped
from the original section lines so each chunk carries the span it actually
covers; chunk text is byte-identical (verified over 150 real markdown files,
847 chunks: 0 text changes, 842 spans corrected, 46 -> 8 collapsed spans).

Side effect: appending a line to a file no longer changes the identity hash of
its earlier chunks, so incremental updates re-embed only the tail.
---
 src/indexer/chunker.ts | 97 +++++++++++++++++++++++++++++++++---------
 1 file changed, 78 insertions(+), 19 deletions(-)

diff --git a/src/indexer/chunker.ts b/src/indexer/chunker.ts
index 99846b1..b2cd081 100644
--- a/src/indexer/chunker.ts
+++ b/src/indexer/chunker.ts
@@ -528,37 +528,96 @@ export function chunkMarkdown(content: string, filePath: string, fileType = "mar
 		}
 	}
 
-	function flush(endLine: number): void {
+	// Paragraph spans are derived from the original section lines, not from the
+	// re-split text: splitting joined text cannot tell how many blank lines a
+	// separator swallowed, which is how every chunk after the first used to inherit
+	// the section's last line number. Chunk *text* is unchanged (same paragraphs, same
+	// join, same token budget); only start/end line numbers become accurate.
+	interface SectionParagraph {
+		text: string;
+		start: number;
+		end: number;
+	}
+
+	function sectionParagraphs(bodyStartLine: number): SectionParagraph[] {
+		const paragraphs: SectionParagraph[] = [];
+		let currentLines: string[] = [];
+		let currentStart = 0;
+		const push = (): void => {
+			if (currentLines.length === 0) return;
+			paragraphs.push({
+				text: currentLines.join("\n"),
+				start: currentStart,
+				end: currentStart + currentLines.length - 1,
+			});
+			currentLines = [];
+		};
+		for (let index = 0; index < sectionLines.length; index++) {
+			const line = sectionLines[index];
+			// Only a truly empty line separates paragraphs: `split(/\n\n+/)` splits on runs of
+			// newlines, and a whitespace-only line is content, not a separator.
+			if (line === "") {
+				push();
+				continue;
+			}
+			if (currentLines.length === 0) currentStart = bodyStartLine + index;
+			currentLines.push(line);
+		}
+		push();
+		// The section body was previously `join("\n").trim()`, which only trims the outer
+		// edges; keep that so chunk text stays byte-identical.
+		const first = paragraphs[0];
+		if (first) first.text = first.text.replace(/^\s+/, "");
+		const last = paragraphs[paragraphs.length - 1];
+		if (last) last.text = last.text.replace(/\s+$/, "");
+		return paragraphs.filter((paragraph) => paragraph.text.length > 0);
+	}
+
+	function flush(_endLine: number): void {
 		const text = sectionLines.join("\n").trim();
 		if (text.length < 50) return;
 
-		const fullText = currentHeading ? `${currentHeading}\n\n${text}` : text;
-		const paragraphs = fullText.split(/\n\n+/);
-		let buffer: string[] = [];
-		let bufferStart = startLine;
+		const bodyStartLine = currentHeading ? startLine + 1 : startLine;
+		const paragraphs: SectionParagraph[] = currentHeading
+			? [{ text: currentHeading, start: startLine, end: startLine }, ...sectionParagraphs(bodyStartLine)]
+			: sectionParagraphs(bodyStartLine);
+		let buffer: SectionParagraph[] = [];
 
 		for (const para of paragraphs) {
-			if (para.length > MAX_TEXT_CHUNK_CHARS) {
-				const oversizedText = buffer.length > 0 ? [...buffer, para].join("\n\n") : para;
-				const oversizedStart = buffer.length > 0 ? bufferStart : endLine;
-				if (buffer.length > 0) {
-					buffer = [];
-				}
+			if (para.text.length > MAX_TEXT_CHUNK_CHARS) {
+				const merged = buffer.length > 0 ? [...buffer, para] : [para];
+				const oversizedText = merged.map((item) => item.text).join("\n\n");
+				const oversizedStart = merged[0].start;
+				buffer = [];
 				pushOversizedMarkdownParagraph(oversizedText, oversizedStart);
-				bufferStart = endLine;
 				continue;
 			}
-			const next = [...buffer, para].join("\n\n");
-			if (estimateTokens(next) > MARKDOWN_TARGET_TOKENS && buffer.length > 0) {
-				pushMarkdownChunk(buffer.join("\n\n"), bufferStart, endLine);
-				buffer = [];
-				bufferStart = endLine;
+			const next = [...buffer, para];
+			if (
+				estimateTokens(
+					next
+						.map((item) => item.text)
+						.join("\n\n"),
+				) > MARKDOWN_TARGET_TOKENS &&
+				buffer.length > 0
+			) {
+				pushMarkdownChunk(
+					buffer.map((item) => item.text).join("\n\n"),
+					buffer[0].start,
+					buffer[buffer.length - 1].end,
+				);
+				buffer = [para];
+				continue;
 			}
-			buffer.push(para);
+			buffer = next;
 		}
 
 		if (buffer.length > 0) {
-			pushMarkdownChunk(buffer.join("\n\n"), bufferStart, endLine);
+			pushMarkdownChunk(
+				buffer.map((item) => item.text).join("\n\n"),
+				buffer[0].start,
+				buffer[buffer.length - 1].end,
+			);
 		}
 	}
 
