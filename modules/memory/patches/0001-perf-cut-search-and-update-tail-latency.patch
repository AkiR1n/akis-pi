--- /dev/null
+++ b/src/storage/kb-lock.ts
@@ -0,0 +1,84 @@
+/**
+ * Cross-process single-writer guard for a knowledge base.
+ *
+ * The engine already serialises mutations inside one process (`runExclusive`), but
+ * nothing stops a nightly sync, a file watcher, and a manual `knowledge_update` from
+ * writing the same KB from three processes at once. They interleave on the chunk
+ * rows, the vector sidecar and the FTS triggers, which is the one way to reach a
+ * state that needs a full rebuild to repair.
+ *
+ * The lock is a `wx`-created file holding `{ pid, at }`. It is treated as stale when
+ * the recorded process is gone or the record is older than `STALE_AFTER_MS`, so a
+ * killed run cannot wedge a KB forever.
+ */
+
+import { mkdirSync, readFileSync, unlinkSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+const STALE_AFTER_MS = 6 * 60 * 60 * 1_000;
+
+export interface KnowledgeLock {
+	release(): void;
+}
+
+function processIsAlive(pid: number): boolean {
+	if (!Number.isInteger(pid) || pid <= 0) return false;
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch (error) {
+		// EPERM means the process exists but belongs to someone else.
+		return (error as NodeJS.ErrnoException).code === "EPERM";
+	}
+}
+
+function readLockRecord(path: string): { pid: number; at: number } | undefined {
+	try {
+		const parsed: unknown = JSON.parse(readFileSync(path, "utf8"));
+		if (typeof parsed !== "object" || parsed === null) return undefined;
+		const pid = (parsed as { pid?: unknown }).pid;
+		const at = (parsed as { at?: unknown }).at;
+		if (typeof pid !== "number" || typeof at !== "number") return undefined;
+		return { pid, at };
+	} catch {
+		return undefined;
+	}
+}
+
+/**
+ * Returns a lock handle, or `undefined` when another live process holds it.
+ * Throws only on unexpected filesystem errors.
+ */
+export function acquireKnowledgeLock(knowledgeDir: string, kbId: string, label: string): KnowledgeLock | undefined {
+	const dir = join(knowledgeDir, "locks");
+	mkdirSync(dir, { recursive: true });
+	const path = join(dir, `${kbId}.lock`);
+	for (let attempt = 0; attempt < 2; attempt++) {
+		try {
+			writeFileSync(path, JSON.stringify({ pid: process.pid, at: Date.now(), label }), { flag: "wx" });
+			let released = false;
+			return {
+				release() {
+					if (released) return;
+					released = true;
+					try {
+						unlinkSync(path);
+					} catch {
+						/* already gone */
+					}
+				},
+			};
+		} catch (error) {
+			if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+			const record = readLockRecord(path);
+			const stale = !record || !processIsAlive(record.pid) || Date.now() - record.at > STALE_AFTER_MS;
+			if (!stale) return undefined;
+			try {
+				unlinkSync(path);
+			} catch {
+				/* raced with another reclaimer */
+			}
+		}
+	}
+	return undefined;
+}
