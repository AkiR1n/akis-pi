+/**
+ * Claims a KB for indexing. Fails when another run is already indexing it, unless
+ * that run looks abandoned (a killed process otherwise leaves the KB unusable:
+ * every search skips a KB whose status is not ready/stale).
+ */
+export function claimKBForIndexing(db: Database.Database, id: string, staleAfterMs = 2 * 60 * 60 * 1_000): boolean {
+	const now = Date.now();
+	const result = db
+		.prepare(
+			`UPDATE knowledge_bases
+       SET status = 'indexing', updated_at = ?
+       WHERE id = ? AND (status != 'indexing' OR updated_at < ?)`,
+		)
+		.run(now, id, now - staleAfterMs);
+	return result.changes === 1;
+}
